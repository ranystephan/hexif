# Copy outside the Git checkout, fill only real absolute paths, set mode 600,
# and submit with HEXIF_RUN_ENV pointing to that private copy.
HEXIF_REPO=/absolute/path/to/clean/hexif
HEXIF_COMMIT=REPLACE_WITH_FULL_40_CHARACTER_GIT_COMMIT
HEXIF_PYTHON=/absolute/path/to/pinned/environment/bin/python
# Set when the environment depends on a cluster Python runtime module.
HEXIF_PYTHON_MODULE=python/3.12.1
# Point to a mode-600 token file; never put a token value in this file.
HEXIF_HF_TOKEN_PATH=/absolute/path/to/huggingface/token
HEXIF_HF_HOME=/absolute/path/to/model/cache
HEXIF_TRAIN_TABLE=/absolute/path/to/frozen/train_cell_table.csv
HEXIF_VAL_TABLE=/absolute/path/to/frozen/validation_cell_table.csv
HEXIF_PAIRS_DIR=/absolute/path/to/registered/real/he_arrays
HEXIF_OUTPUT_DIR=/absolute/path/to/new/run/output

# Select one prespecified configuration.
HEXIF_TRAINER=v4
HEXIF_ENCODER=uni2
HEXIF_LABEL_SET=spacec
HEXIF_SEED=42
HEXIF_BATCH=32
HEXIF_GRAD_ACCUM_STEPS=4
HEXIF_NUM_WORKERS=4
HEXIF_EPOCHS=30
HEXIF_EARLY_STOP_PATIENCE=5
HEXIF_MAX_TRAIN_CELLS_PER_EPOCH=120000

# Smoke runs are mandatory before production. Set to 0 only after review.
HEXIF_SMOKE=1
HEXIF_RESTART=0
